# Data source: true = built-in demo data, false = a Traccar server
NEXT_PUBLIC_DEMO_MODE=true

# Traccar server (proxied under /api by next.config.js)
TRACCAR_URL=http://localhost:8082

# Traccar live updates. Leave empty in production when the dashboard and Traccar share one domain
# (wss://<same host>/api/socket is used). In local development point it straight at Traccar:
# the browser sends the session cookie to localhost on any port.
NEXT_PUBLIC_TRACCAR_WS_URL=ws://localhost:8082/api/socket

# Map Configuration
# Base map style (default: OpenFreeMap, like the Fink web app)
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
